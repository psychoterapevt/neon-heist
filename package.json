{
  "name": "neon-heist",
  "private": true,
  "version": "1.0.0",
  "description": "NEON HEIST — a browser game controlled only by your body through the webcam, with an explainable gesture Error Engine.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "predev": "node scripts/copy-mediapipe-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe-wasm.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
